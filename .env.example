ORACLE_PASSWORD=change-me-admin
# 테이블 소유자. 마이그레이션(./gradlew migrate)만 쓴다(테이블 생성·변경, 앱 계정에 권한 부여). 서버는 비밀번호를 읽지 않는다.
DB_OWNER_USERNAME=corebank
DB_OWNER_PASSWORD=change-me-owner
# 앱 실행 계정. 소유자가 준 권한만 있다. 영문으로 시작하는 영문·숫자·_ 30자 이내, 비밀번호에 큰따옴표 금지.
DB_APP_USERNAME=corebank_app
DB_APP_PASSWORD=change-me-app
# JWT 서명 키. 32바이트 이상의 임의 문자열. 예: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# 첫 관리자 계정. 서버가 처음 시작할 때 한 번만 만든다. 비밀번호는 12자 이상.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
